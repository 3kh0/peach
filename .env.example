# Cloudflare Turnstile — gates the email reveal (server/api/contact-email.post.ts).
# Copy to .env for local dev. .env is gitignored; .env.example is not, so never
# put the real secret in this file.

# Secret half of the Turnstile widget. In production this belongs in the
# Cloudflare Pages project as an encrypted variable, never in a file.
NUXT_TURNSTILE_SECRET=

# Hostnames siteverify is allowed to report back. This local value is for dev
# only — the deployed value must not contain localhost or 127.0.0.1.
NUXT_TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Both of these already have working defaults in nuxt.config.ts. Override only
# to point a preview build at a different widget or address.
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEr2UitoTPwFmI-P
# NUXT_CONTACT_EMAIL=hello@3kh0.net
